# Local demo only. Use a strong unique JWT secret for deployment.
DATABASE_URL=postgres://bookflow:bookflow_local@localhost:54329/bookflow
JWT_SECRET=replace-with-a-long-random-secret
PORT=4170
CLIENT_ORIGIN=http://localhost:5175
# Optional: use your own Photon-compatible geocoder for place suggestions.
# PHOTON_URL=https://photon.komoot.io/api/
# disabled, mock (limited deterministic parser, not an LLM), or gemini.
AI_PROVIDER=disabled
# GEMINI_API_KEY=your-key
# GEMINI_MODEL=gemini-3.5-flash-lite
# Public deployments require CLIENT_ORIGIN=https://your-domain, SMTP_HOST, and MAIL_FROM.
# SMTP_PORT=587
# SMTP_HOST=smtp.example.com
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=BookFlow <no-reply@example.com>
# Booking notification delivery: inbox, file, or smtp.
# NOTIFICATION_MODE=smtp
